erDiagram
    direction TB

    USER {
        uuid user_id PK
        string name
        string username UK
        string email UK
        datetime created_at
    }

    CONVERSATION {
        uuid conversation_id PK
        string title
        string type
    }

    CONVERSATION_PARTICIPANT {
        uuid conversation_id PK, FK
        uuid user_id PK, FK
        string role
        datetime joined_at
    }

    MESSAGE {
        uuid message_id PK
        uuid conversation_id FK
        uuid sender_id FK
        string content
        datetime sent_at
    }

    ATTACHMENT {
        uuid attachment_id PK
        uuid message_id FK
        string file_name
        string mime_type
        bigint size_bytes
        string storage_key
    }

    USER ||--o{ CONVERSATION_PARTICIPANT : participates
    CONVERSATION ||--|{ CONVERSATION_PARTICIPANT : has_users
    USER ||--o{ MESSAGE : sends
    CONVERSATION ||--o{ MESSAGE : contains
    MESSAGE ||--|{ ATTACHMENT : has